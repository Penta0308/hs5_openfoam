#!/usr/bin/env bash
set -euo pipefail

source /opt/openfoam14/etc/bashrc

# OpenFOAM.org v14 reads patch regions from the OBJ `g` field only.
# It ignores OBJ `usemtl` and MTL files entirely, so this script
# surface-checks only the normalized single OBJ that contains `g`-encoded
# patches/zones. No raw OBJ or MTL is used as input here.
surfaceCheck constant/triSurface/hs5_cfd.openfoam.obj | tee log.surfaceCheck.hs5_cfd

# Meshing/region split is intentionally geometry-driven and will be completed
# from hs5_cfd.ipt only. This script verifies that Inventor export and
# OpenFOAM v14 tooling are wired correctly. OBJ is used so material/color
# assignments can be post-processed into OpenFOAM patch surfaces.

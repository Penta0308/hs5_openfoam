#!/usr/bin/env bash

source /opt/openfoam14/etc/bashrc
set -euo pipefail

CASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$CASE_DIR"

BACKUP_DIR=$(mktemp -d)
restore_cht() {
    install -m 0644 "$BACKUP_DIR/controlDict" "$CASE_DIR/system/controlDict"
    install -m 0644 "$BACKUP_DIR/fvSolution" "$CASE_DIR/system/fluid/fvSolution"
    rm -rf "$BACKUP_DIR"
}
install -m 0644 "$CASE_DIR/system/controlDict" "$BACKUP_DIR/controlDict"
install -m 0644 "$CASE_DIR/system/fluid/fvSolution" "$BACKUP_DIR/fvSolution"
trap restore_cht EXIT

install -m 0644 "$CASE_DIR/flow/system/controlDict" "$CASE_DIR/system/controlDict"
install -m 0644 "$CASE_DIR/flow/system/fluid/fvSolution" "$CASE_DIR/system/fluid/fvSolution"

foamRun -solver incompressibleFluid -region fluid | tee log.flow
python3 "$CASE_DIR/tools/flow_runner.py" log.flow

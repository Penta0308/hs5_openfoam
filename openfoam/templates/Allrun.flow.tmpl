#!/usr/bin/env bash

source /opt/openfoam14/etc/bashrc
set -euo pipefail

CASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$CASE_DIR"

FLOW_DIR="$CASE_DIR/flow"
rm -rf "$FLOW_DIR/0" "$FLOW_DIR/constant"
find "$FLOW_DIR" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[1-9][0-9]*(\.[0-9]+)?' -exec rm -rf {} +
mkdir -p "$FLOW_DIR/0" "$FLOW_DIR/constant" "$FLOW_DIR/system"
cp -a "$CASE_DIR/constant/fluid/." "$FLOW_DIR/constant/"
cat > "$FLOW_DIR/constant/physicalProperties" <<'EOF'
FoamFile
{
    format      ascii;
    class       dictionary;
    object      physicalProperties;
}
viscosityModel constant;
nu             1.5e-5;
EOF
for field in U k omega nut; do
    install -m 0644 "$CASE_DIR/0/fluid/$field" "$FLOW_DIR/0/$field"
done
cat > "$FLOW_DIR/0/p" <<'EOF'
FoamFile { format ascii; class volScalarField; object p; }
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    patch_inlet  { type totalPressure; p0 uniform 0; value uniform 0; }
    patch_outlet { type fixedValue; value uniform 0; }
    patch_blade  { type zeroGradient; }
    wall         { type zeroGradient; }
    fluid_to_aluminum { type zeroGradient; }
}
EOF
install -m 0644 "$CASE_DIR/system/fluid/fvSchemes" "$FLOW_DIR/system/fvSchemes"
install -m 0644 "$FLOW_DIR/system/fluid/fvSolution" "$FLOW_DIR/system/fvSolution"
install -m 0644 "$CASE_DIR/constant/fvModels" "$FLOW_DIR/constant/fvModels"

foamRun -case "$FLOW_DIR" -solver incompressibleFluid | tee log.flow
python3 "$CASE_DIR/tools/flow_runner.py" log.flow

FLOW_TIME=$(find "$FLOW_DIR" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]+(\.[0-9]+)?' -printf '%f\n' | sort -V | tail -1)
test -n "$FLOW_TIME"
mkdir -p "$CASE_DIR/$FLOW_TIME/fluid"
for field in U k omega nut; do
    install -m 0644 "$FLOW_DIR/$FLOW_TIME/$field" "$CASE_DIR/$FLOW_TIME/fluid/$field"
done
install -m 0644 "$CASE_DIR/0/fluid/p" "$CASE_DIR/$FLOW_TIME/fluid/p"

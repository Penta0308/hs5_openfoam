/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM: The Open Source CFD Toolbox                                   |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamMultiRun;

regionSolvers
{
    fluid       fluid;
    aluminum    solid;
}

startFrom       latestTime;
startTime       0;
stopAt          endTime;
// Bounded steady pseudo-time run; reruns resume from the latest output.
endTime         1000;
deltaT          1;

adjustTimeStep  no;

writeControl    timeStep;
writeInterval   100;
writeFormat     ascii;
writePrecision  12;

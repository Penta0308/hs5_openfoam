FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
    p { solver GAMG; tolerance 1e-7; relTol 0.05; smoother GaussSeidel; }
    pFinal { $p; relTol 0; }
    rho { solver GAMG; tolerance 1e-7; relTol 0.05; smoother GaussSeidel; }
    rhoFinal { $rho; relTol 0; }
    "(U|k|omega|h|T)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.05; }
    UFinal { $U; relTol 0; }
    hFinal { $h; relTol 0; }
    kFinal { $k; relTol 0; }
    omegaFinal { $omega; relTol 0; }
}
PIMPLE
{
    flow false;
    thermophysics true;
    nOuterCorrectors 2;
    nCorrectors 0;
    nNonOrthogonalCorrectors 0;
    residualControl
    {
        h       1e-5;
    }
}
relaxationFactors { equations { "(h|T)" 0.7; } }

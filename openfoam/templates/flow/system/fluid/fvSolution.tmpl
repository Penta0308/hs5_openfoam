FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
    p { solver GAMG; tolerance 1e-7; relTol 0.05; smoother GaussSeidel; }
    pFinal { $p; relTol 0; }
    "(U|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.05; }
    UFinal { $U; relTol 0; }
    kFinal { $k; relTol 0; }
    omegaFinal { $omega; relTol 0; }
}
PIMPLE
{
    nOuterCorrectors 3;
    nCorrectors 3;
    nNonOrthogonalCorrectors 1;
    residualControl
    {
        p       1e-5;
        U       1e-5;
        k       1e-5;
        omega   1e-5;
    }
}
relaxationFactors { fields { p 0.2; } equations { "(U|k|omega)" 0.5; } }

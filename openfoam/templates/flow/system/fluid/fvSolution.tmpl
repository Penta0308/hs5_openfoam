FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
    p { solver GAMG; tolerance 1e-6; relTol 0; smoother GaussSeidel; }
    pFinal { $p; relTol 0; }
    "(U|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-7; relTol 0.05; }
    UFinal { $U; relTol 0; }
    kFinal { $k; relTol 0; }
    omegaFinal { $omega; relTol 0; }
}
SIMPLE
{
    consistent yes;
    nNonOrthogonalCorrectors 1;
    residualControl
    {
        p             1e-5;
        "(Ux|Uy|Uz)"  1e-5;
    }
}
relaxationFactors { fields { p 0.1; } equations { "U" 0.3; } }

FoamFile { format ascii; class volScalarField; object T; }
dimensions      [0 0 0 1 0 0 0];
internalField   uniform 293.15;
boundaryField
{
    aluminum_to_fluid { type coupledTemperature; value uniform 293.15; }
    patch_heatsource
    {
        // 4 W is total power over this 10100-face patch, never a W/m2 flux.
        type externalWallHeatFluxTemperature;
        mode power;
        Q uniform 4;
        value uniform 293.15;
    }
    wall { type zeroGradient; }
    patch_outlet { type zeroGradient; }
}

#!/usr/bin/env bash
set -euo pipefail

CASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$CASE_DIR"

rm -rf constant/polyMesh constant/fluid/polyMesh constant/aluminum/polyMesh processor* postProcessing
rm -f log.*
find . -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex './[1-9][0-9]*(\.[0-9]+)?' -exec rm -rf {} +
